# Most features are optional — the site works without keys (they degrade
# gracefully). The blog CMS, lead email + lead storage need the keys below.

# AI tools (instant audit + ad-copy generator) — written by Claude when set
ANTHROPIC_API_KEY=

# Contact + lead form email delivery (Resend)
RESEND_API_KEY=
# Comma-separated list of recipients. Leave blank to use the built-in team
# default: contact@ppcguru.ca, sales@ppcguru.ca, marketing@ppcguru.ca
CONTACT_TO_EMAIL=contact@ppcguru.ca,sales@ppcguru.ca,marketing@ppcguru.ca
CONTACT_FROM_EMAIL=          # must be on a Resend-verified domain

# Cloudflare Turnstile — the "I'm not a robot" check on EVERY form.
# Free, unlimited. Get both keys at: https://dash.cloudflare.com → Turnstile →
# Add widget (Domains: ppcguru.ca + *.vercel.app, Widget mode: Managed).
# Set BOTH or neither: with only one set the widget never renders and the check
# is skipped (see lib/turnstile.ts). Once both are set the check is enforced —
# a missing or invalid token is rejected.
# Without them, forms still fall back to lib/spam-filter.ts heuristics.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Supabase — blog CMS + lead storage (run supabase/schema.sql once)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Blog CMS admin login (used at /admin)
ADMIN_PASSWORD=

# ── Visitor identity + behavioural email journeys ──────────────────────────
# Turns anonymous browsing into a named timeline once someone submits a form,
# and emails them on a return visit / repeated pricing interest.
# Requires: supabase/visitor-tracking.sql THEN supabase/visitor-identity.sql.
# Full walkthrough: VISITOR-IDENTITY-SETUP.md
#
# Signs the httpOnly recognition cookie + unsubscribe tokens. Falls back to
# ADMIN_PASSWORD when blank, so it's optional — but set a dedicated random
# value (e.g. `openssl rand -hex 32`) so rotating the admin password doesn't
# log every known visitor out and invalidate live unsubscribe links.
IDENTITY_SECRET=
# Master kill switch for automated visitor emails. Only "false" disables them;
# internal sales alerts stop too. Identity stitching + /admin/people keep
# working either way.
JOURNEYS_ENABLED=true

# Zoho CRM — fallback for new submissions when GoHighLevel is not configured.
# This org is on the CANADA data centre, so create the
# Self Client at https://api-console.zohocloud.ca (NOT the .com console) with
# scope ZohoCRM.modules.leads.CREATE,ZohoCRM.modules.leads.READ.
# Full walkthrough: ZOHO-CRM-SETUP.md
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Domains default to the Canada DC — only set these if the org moves.
# ZOHO_ACCOUNTS_DOMAIN=accounts.zohocloud.ca
# ZOHO_API_DOMAIN=www.zohoapis.ca
# Must be an EXISTING option in the Leads → Lead Source picklist. If it isn't,
# the lead is still created but without a source (check the server logs).
ZOHO_LEAD_SOURCE=Web Download
# Optional: numeric Zoho user ID to own all website leads. Blank = the API user.
ZOHO_LEAD_OWNER_ID=

# GoHighLevel (LeadConnector) — replaces Zoho when both values are configured.
# Supabase lead storage and team email delivery remain enabled separately.
# Sub-account → Settings → Private Integrations → Create. Scopes:
#   contacts.write (contacts/tags/notes), contacts.readonly (note deduplication)
#   (+ locations.readonly for location verification; locations/customFields.readonly for optional mappings)
# GHL_LOCATION_ID is the sub-account id (Settings → Business Profile, or the
# /location/<id>/ segment in the HighLevel URL). Both required; unset = Zoho fallback.
GHL_API_TOKEN=
GHL_LOCATION_ID=
# Tags added to live submissions without replacing existing tags.
# A per-form tag (form-contact, form-popup-audit, ...) is added automatically.
GHL_LEAD_TAGS=website-lead
# ISO country used to normalise unformatted phone numbers (default CA).
GHL_DEFAULT_COUNTRY=CA
# Optional: assign every website lead to one user (HighLevel user id).
GHL_ASSIGNED_USER_ID=
# Optional: write budget/services/source into real custom fields as well as the
# contact note. Prefer the field id (or id:<id>); keys use contact.example or key:<key>.
GHL_CUSTOM_FIELD_BUDGET=
GHL_CUSTOM_FIELD_SERVICES=
GHL_CUSTOM_FIELD_SOURCE=

# IndexNow — instant crawl pings to Bing/Yandex on blog publish (optional).
# Any random 8–128 char hex string; it's also served at /indexnow-key.txt.
# Leave blank to disable pinging. (Google doesn't use IndexNow — see lib/indexnow.ts.)
INDEXNOW_KEY=

# Analytics — both have working defaults baked into
# components/analytics/third-party.tsx, so only set these to point a
# staging/preview deploy at a different container/project (or blank them to
# disable tracking there).
NEXT_PUBLIC_GTM_ID=GTM-NRX9BRWF
NEXT_PUBLIC_CLARITY_ID=xpxkvrbt7j

# ── Blog editor (/admin) ──────────────────────────────────────────────────────
# The blog's source of truth is content/blog/*.md in Git, so the admin editor
# commits markdown through the GitHub API instead of writing to a database.
# Fine-grained personal access token, scoped to the site repo, with the
# "Contents: Read and write" permission. Without it /admin/blog is read-only.
BLOG_GITHUB_TOKEN=
# Optional — defaults below match the live site.
BLOG_REPO=contact576/PPCguru-website
BLOG_BRANCH=master
